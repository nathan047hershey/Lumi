# Required on Vercel
JWT_SECRET=change-me-to-a-long-random-string

# Groq (CV + form answers)
GROQ_API_KEY=
# GROQ_API_KEY_1=
ANSWERS_PROVIDER=groq

# Optional Outlook Graph
OUTLOOK_CLIENT_ID=
OUTLOOK_AUTH_TENANT=common
OUTLOOK_REDIRECT_URI=https://YOUR-APP.vercel.app/api/user/mailbox/outlook/callback

# SQLite lives under /tmp on Vercel (ephemeral). Leave unset unless you use a custom volume.
# LUMI_DATA_ROOT=/tmp/lumi-data

# Extra browser origins if you use a custom domain
# LUMI_CORS_ORIGINS=https://your-domain.com

# Do not set RABBITMQ_URL on Vercel — resume generation runs inline.
