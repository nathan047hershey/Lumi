# Local SQLite. On Vercel, switch this to a Postgres URL (Neon, Supabase, Prisma Postgres).
DATABASE_URL="file:./dev.db"

# Required. Copied from the old desk when you run scripts/merge-legacy-env.mjs
JWT_SECRET="replace-with-a-long-random-string"

# AI providers (optional extras after GROQ_API_KEY_1…N)
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=
MINIMAX_API_KEY_2=
ANSWERS_PROVIDER=groq

# Outlook Graph
OUTLOOK_CLIENT_ID=
OUTLOOK_REDIRECT_URI=http://localhost:3000/api/user/outlook/callback
OUTLOOK_AUTH_TENANT=common
